# Graphile Worker cron schedule (apps/api/src/worker/index.ts). Default path
# per graphile-worker's own convention: <cwd>/crontab, i.e. this file, since
# `pnpm --filter @syntaxwp/api worker` runs with apps/api as cwd.
#
# Prune replay-protection nonces older than their 5-minute validity window
# (A5a.1) — nothing ever needs to read a row this old again.
*/5 * * * * site_auth_nonce_prune

# Garbage-collect work orders nobody claimed within their 5-minute window
# (A3.2, §8.2) — every minute, since a stale claimable-looking order sitting
# around for up to 5 extra minutes is worse than the cost of checking often.
* * * * * work_order_expiry_sweep

# Delete snapshot rows (and their R2/MinIO blobs) past the 30-day retention
# window (A4.4, §14.2). Once daily, off-peak — a 30-day window doesn't need
# the frequent checking the shorter-lived sweeps above do.
0 3 * * * snapshot_retention_sweep

# Daily CrUX vitals collection (desktop + mobile) — low frequency, API-rate-safe.
0 6 * * * performance_collector

# 15-min synthetic TTFB pings — state-machine regression detection + auto-remediation.
*/15 * * * * performance_ping

# WPVulnerability.net feed sync — matches installed plugins/core against known CVEs.
*/15 * * * * vulnerability_feed_sync

# SSL cert + domain expiry checks.
*/15 * * * * ssl_domain_watch

# Daily headless WooCommerce checkout probe.
0 2 * * * synthetic_checkout_check

# Heartbeat drift alarm (§5.1 Source 4) — raise/auto-resolve a server-level
# outage incident when a site's 60s heartbeat goes silent for >180s. Runs
# every minute so the 180s threshold isn't blurred by a coarser sweep.
* * * * * heartbeat_drift_check

# Core file checksum audit + auto-repair (§8, §12.1-12.2), wp7_native sites
# only — see verify_core_integrity ability / IntegrityScanner.php.
0 4 * * * core_integrity_check
